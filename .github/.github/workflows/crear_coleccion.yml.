name: Crear colección manual de pruebas

on:
  workflow_dispatch:
    inputs:
      confirmar:
        description: 'Escribe CREAR para autorizar la creación de Novedades V3 Test'
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: crear-coleccion-novedades-v3
  cancel-in-progress: false

jobs:
  crear:
    if: ${{ inputs.confirmar == 'CREAR' }}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4
      - name: Configurar Python
        uses: actions/setup-python@v6
        with:
          python-version: '3.11'
      - name: Instalar requests
        run: python -m pip install 'requests>=2.32,<3'
      - name: Crear colección manual
        env:
          SHOPIFY_SHOP: ${{ secrets.SHOPIFY_SHOP }}
          SHOPIFY_CLIENT_ID: ${{ secrets.SHOPIFY_CLIENT_ID }}
          SHOPIFY_CLIENT_SECRET: ${{ secrets.SHOPIFY_CLIENT_SECRET }}
          SHOPIFY_API_VERSION: '2026-10'
          CONFIRM_CREATE_COLLECTION: 'YES'
        run: python crear_coleccion.py
